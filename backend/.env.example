TECBOT_APP_NAME=TEC Bot API
TECBOT_CORS_ORIGINS=http://localhost:5173
# Distancia coseno máxima para aceptar un fragmento como evidencia.
# Calíbrala con: python scripts/consultar.py --evaluar
TECBOT_UMBRAL_DISTANCIA=0.53
# Ollama: redacta la respuesta con los fragmentos recuperados.
TECBOT_USAR_OLLAMA=true
TECBOT_OLLAMA_MODEL=llama3.2:3b
TECBOT_OLLAMA_TIMEOUT=60
